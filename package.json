{
  "name": "byteql",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm build && pnpm -r check && pnpm format:check",
    "check:bundle": "pnpm --filter @byteql/web check:bundle",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare:pages": "node apps/web/scripts/prepare-pages-artifact.mjs apps/web/dist",
    "verify:pages": "node apps/web/scripts/verify-pages-artifact.mjs apps/web/dist",
    "deploy:pages": "pnpm verify:pages && wrangler pages deploy apps/web/dist --project-name=byteql --branch=main",
    "release:pages": "pnpm check && pnpm check:bundle && pnpm prepare:pages && pnpm deploy:pages",
    "test": "pnpm build && pnpm -r test",
    "test:e2e": "pnpm --filter @byteql/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.20.0",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
