{
  "name": "byteql",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm build && pnpm -r check && pnpm format:check",
    "check:bundle": "pnpm --filter @byteql/web check:bundle",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm build && pnpm -r test",
    "test:e2e": "pnpm --filter @byteql/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.20.0",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
