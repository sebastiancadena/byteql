{
  "name": "@byteql/midi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "byteql-pack build && tsc -p tsconfig.json",
    "check": "pnpm --filter @byteql/core build && byteql-pack build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @byteql/core build && byteql-pack build && vitest && pnpm test:built",
    "test:built": "pnpm build && node test/built-runtime.mjs"
  },
  "dependencies": {
    "@byteql/core": "workspace:*",
    "kaitai-struct": "^0.11.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@byteql/pack-tools": "workspace:*"
  }
}
